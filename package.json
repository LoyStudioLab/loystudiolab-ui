{
  "name": "loystudiolab-ui",
  "private": true,
  "version": "0.1.2",
  "description": "LoyStudioLab component library: tokens, components and page patterns for the studio's sites and Lab products, distributed as a shadcn-compatible registry.",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "build:manifest": "node scripts/build-manifest.mjs",
    "build:docs": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build": "npm run build:tokens && npm run check:contrast && npm run build:manifest && npm run build:registry && npm run build:docs",
    "doctor": "node scripts/lsl-doctor.mjs src docs/src --manifest docs/public/manifest.json",
    "test": "vitest run",
    "test:visual": "playwright test",
    "smoke": "node scripts/smoke-install.mjs",
    "sync:skill": "node scripts/sync-skill.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.2",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/parser": "^7.29.14",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "react-docgen": "^8.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.4",
    "vitest": "^4.0.0"
  }
}
