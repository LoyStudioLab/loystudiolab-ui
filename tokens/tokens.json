{
  "$description": "LoyStudioLab design tokens, Palette B 'Warm Studio'. The only place token values live. Edit here, then run `npm run build:tokens`. Format: W3C Design Tokens (DTCG).",
  "color": {
    "$type": "color",
    "paper":      { "$value": "#F4EFE4", "$description": "Dominant surface. Page background." },
    "paper-alt":  { "$value": "#EDE6D6", "$description": "Alternating section surface." },
    "ink":        { "$value": "#1B1A17", "$description": "Text, 2px borders, ink surfaces. The system's authority." },
    "ink-2":      { "$value": "#4A463E", "$description": "Secondary text: body copy, eyebrows, captions (8.19:1 on paper)." },
    "concrete":   { "$value": "#A39B8B", "$description": "Non-text only: disabled fills, chart series, decoration. Fails AA as text (2.40:1)." },
    "rule":       { "$value": "#D8D2C2", "$description": "Decorative inner dividers on paper. Secondary text on ink surfaces (11.53:1)." },
    "butter":     { "$value": "#FFB400", "$description": "The single accent. One CTA per page, the Studio square, hover underlines, focus rings, selection. Never a surface, never text on paper." },
    "petrol":     { "$value": "#2E5C68", "$description": "Marks the Loy layer only (founders). 6.43:1 on paper." },
    "petrol-light": { "$value": "#7FA9B4", "$description": "Loy marker on ink surfaces (6.83:1 on ink)." },
    "brick":      { "$value": "#AE4B32", "$description": "Error borders and icons; error text on paper (4.75:1)." },
    "brick-deep": { "$value": "#9E4129", "$description": "Error text on any paper surface, incl. paper-alt (5.21:1)." },
    "brick-light": { "$value": "#E08A72", "$description": "Error text on ink surfaces (6.67:1)." },
    "ochre":      { "$value": "#C99A3B", "$description": "Reference palette. Value bars and chart series only, never text." },
    "signal":     { "$value": "#17B8A6", "$description": "Reserved for AI and computing states. Fills, outlines, indicators. Text only on ink (7.00:1)." },
    "signal-ink": { "$value": "#0E6E64", "$description": "Signal as text on paper surfaces (5.33 paper, 4.92 alt)." }
  },
  "surface": {
    "$description": "Surfaces set contextual variables so components adapt without props. Values are color token names.",
    "paper": { "bg": "paper", "fg": "ink", "fg-2": "ink-2", "border": "ink", "divider": "rule", "focus-inner": "butter", "focus-outer": "ink", "danger": "brick-deep", "loy": "petrol", "signal-fg": "signal-ink", "hover": "paper-alt" },
    "alt":   { "bg": "paper-alt", "fg": "ink", "fg-2": "ink-2", "border": "ink", "divider": "rule", "focus-inner": "butter", "focus-outer": "ink", "danger": "brick-deep", "loy": "petrol", "signal-fg": "signal-ink", "hover": "paper" },
    "ink":   { "bg": "ink", "fg": "paper", "fg-2": "rule", "border": "paper", "divider": "ink-2", "focus-inner": "butter", "focus-outer": "paper", "danger": "brick-light", "loy": "petrol-light", "signal-fg": "signal", "hover": "ink-2" }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Jost", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Display and headings. Revival of Koch's Kabel (1927)." },
    "body":    { "$value": ["Archivo", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Body and UI. A grotesque under the geometric display face." },
    "mono":    { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
  },
  "fontLink": { "$value": "https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Jost:wght@500;600;700&display=swap" },
  "type": {
    "$description": "Fluid scale anchored to the design board at 1280px wide.",
    "display": { "size": "clamp(2.5rem, 1.25rem + 3.75vw, 4rem)",       "lineHeight": "1.02", "tracking": "-0.025em", "weight": "700", "family": "display", "board": "64px" },
    "h1":      { "size": "clamp(2rem, 1.4rem + 1.5vw, 2.5rem)",          "lineHeight": "1.06", "tracking": "-0.02em",  "weight": "700", "family": "display", "board": "40px" },
    "h2":      { "size": "clamp(1.5rem, 1.25rem + 0.6vw, 1.75rem)",      "lineHeight": "1.15", "tracking": "-0.01em",  "weight": "600", "family": "display", "board": "28px" },
    "h3":      { "size": "1.25rem",                                       "lineHeight": "1.25", "tracking": "-0.005em", "weight": "600", "family": "display", "board": "20px" },
    "lead":    { "size": "clamp(1.0625rem, 1rem + 0.35vw, 1.25rem)",     "lineHeight": "1.55", "tracking": "0",        "weight": "400", "family": "body",    "board": "20px" },
    "body":    { "size": "1rem",                                          "lineHeight": "1.6",  "tracking": "0",        "weight": "400", "family": "body",    "board": "16-18px" },
    "small":   { "size": "0.875rem",                                      "lineHeight": "1.5",  "tracking": "0",        "weight": "400", "family": "body",    "board": "14px" },
    "eyebrow": { "size": "0.8125rem",                                     "lineHeight": "1.4",  "tracking": "0.18em",   "weight": "600", "family": "display", "board": "13px, 3px tracking", "transform": "uppercase" },
    "label":   { "size": "0.75rem",                                       "lineHeight": "1.4",  "tracking": "0.08em",   "weight": "600", "family": "body",    "board": "12px", "transform": "uppercase" }
  },
  "space": {
    "$type": "dimension",
    "$description": "Base-8 grid. Tailwind steps 2, 4, 6, 8, 12, 16, 24 map to 8, 16, 24, 32, 48, 64, 96px. Step 1 (4px) and 3 (12px) are half-steps for tight UI only.",
    "1": { "$value": "8px" }, "2": { "$value": "16px" }, "3": { "$value": "24px" }, "4": { "$value": "32px" },
    "6": { "$value": "48px" }, "8": { "$value": "64px" }, "12": { "$value": "96px" }
  },
  "border": {
    "width": { "$type": "dimension", "default": { "$value": "2px" }, "focus": { "$value": "3px" } },
    "radius": { "$type": "dimension", "$value": "0px", "$description": "Zero, everywhere, no exceptions." }
  },
  "motion": {
    "duration": { "$type": "duration", "fast": { "$value": "150ms" }, "base": { "$value": "250ms" }, "slow": { "$value": "550ms" } },
    "easing": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0.7, 0.2, 1] } }
  },
  "layout": {
    "screens": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" },
    "maxWidth": { "site": "1280px", "prose": "40rem" },
    "headerHeight": { "base": "72px", "lg": "80px" },
    "touchTarget": "44px"
  },
  "z": { "header": 40, "overlay": 50, "toast": 60, "skip": 100 }
}
